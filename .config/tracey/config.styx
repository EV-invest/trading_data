@schema {id crate:tracey-config@1, cli tracey}

specs (
  {
    name trading_data
    include (docs/spec/**/*.md)
    impls (
      {
        name rust
        include (**/*.rs)
        exclude (**/target/** tmp/**)
      }
    )
  }
  {
    name trading_data_dag
    include (trading_data_dag/spec.md)
    impls (
      {
        name rust
        include (**/*.rs)
        exclude (**/target/** tmp/**)
      }
    )
  }
)
